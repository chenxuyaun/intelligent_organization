# Copy this file to a protected location outside the repository, then replace every example value.
# PRODUCT_ENV_FILE must point to the absolute path of that copied file.
PRODUCT_ENV_FILE=/etc/org-intelligence/team-a.env

# Pick a different project name and host port for every team on the same Docker host.
IMAGE_TAG=2026-11-19-1
HOST_PORT=4173
BACKUP_DIR=/srv/org-intelligence/team-a/backups
OIDC_CLIENT_SECRET_FILE=/etc/org-intelligence/team-a/oidc_client_secret
MODEL_API_KEY_FILE=/etc/org-intelligence/team-a/model_api_key

APP_MODE=product
ORG_NAME=Example Team
DATA_DIR=/var/lib/org-intelligence/current
APP_PUBLIC_URL=https://support.example.com
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_MAX_CALLS_PER_HOUR=60
